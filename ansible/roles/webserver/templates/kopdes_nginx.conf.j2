# ==============================================================================
# KopDes Merah Putih - Nginx Virtual Host Configuration (AWS Native / AL2023)
# ==============================================================================

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root {{ app_dest_dir }}/public;
    index index.php index.html;

    # Logging
    access_log /var/log/nginx/kopdes_access.log;
    error_log  /var/log/nginx/kopdes_error.log warn;

    # Trust Forwarded Headers dari AWS Application Load Balancer
    set_real_ip_from 10.0.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # Routing Front-Controller
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP-FPM Handler via Unix Socket
    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:{{ php_fpm_sock | default('/run/php/php-fpm.sock') }};
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
        fastcgi_read_timeout 60s;
    }

    # Proteksi file sensitif (.env, .git, .sql, .sh)
    location ~ /\.(?!well-known).* {
        deny all;
    }

    location ~* \.(sql|sqlite|sqlite3|db|env|log|md|sh|tf|j2)$ {
        deny all;
    }

    # Cache static assets
    location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}
