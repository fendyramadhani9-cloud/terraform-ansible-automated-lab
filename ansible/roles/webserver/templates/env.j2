# ==============================================================================
# KopDes Environment Configuration
# Di-generate secara otomatis oleh Ansible untuk AWS Native Infrastructure
# ==============================================================================

APP_NAME="{{ app_name }}"
APP_ENV={{ app_env | default('production') }}
APP_DEBUG={{ app_debug | lower }}
APP_URL={{ 'http://' ~ alb_dns_name if alb_dns_name else 'http://localhost' }}

# Cluster & Load Balancer Awareness
SERVER_NODE={{ server_node_name | default(ansible_hostname | default('WEB-ASG')) }}
ALB_DNS_NAME={{ alb_dns_name | default('') }}
HAPROXY_STATUS=ONLINE

# Amazon RDS MySQL Connection
DB_CONNECTION=mysql
DB_HOST={{ db_host }}
DB_PORT={{ db_port | default(3306) }}
DB_NAME={{ db_name | default('kopdes') }}
DB_USER={{ db_user | default('kopdes_admin') }}
DB_PASS={{ db_password }}

# Amazon Simple Notification Service (SNS) Configuration - 100% AWS Academy Ready
AWS_REGION={{ aws_region | default('us-east-1') }}
SNS_TOPIC_ARN={{ sns_topic_arn | default('') }}
SNS_RECIPIENT_EMAIL={{ sns_recipient_email | default(ses_recipient_email | default('admin@kopdes.id')) }}


# Session & Security
SESSION_LIFETIME=7200
